# .env file for Go Authentication Proxy

# --- Core Proxy Settings ---
# Address and port the proxy listens on inside the container.
PROXY_ADDR=:8080

# --- Authentication Settings ---
# Enable or disable Basic Authentication (true or false).
PROXY_AUTH_ENABLED=true

# Username and password for Basic Authentication.
PROXY_USER=proxyuser
PROXY_PASS=proxypass123

# --- Logging Settings ---
# Enable verbose logging (true or false).
PROXY_VERBOSE=false

# --- Timeout Settings ---
# Timeout for establishing TCP connections to upstream servers.
PROXY_DIAL_TIMEOUT=10s

# Timeout for the TLS handshake when connecting to upstream HTTPS servers.
PROXY_TLS_TIMEOUT=10s

# Maximum time the server will keep an idle client connection open.
PROXY_IDLE_TIMEOUT=120s

# Maximum time the server waits to read the complete headers from a client request.
PROXY_READ_HEADER_TIMEOUT=10s
